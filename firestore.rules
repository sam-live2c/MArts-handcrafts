rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // PILLAR 1 & 2: DEFAULT CLOSED & HELPER FUNCTIONS
    // ==========================================
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{testId} {
      allow read: if true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailOwner() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             (
               (resource != null && resource.data.get('email', '') == request.auth.token.email) ||
               (incoming() != null && incoming().get('email', '') == request.auth.token.email)
             );
    }

    // Secure Admin Check:
    // 1. Dedicated admins/{uid} document verification
    // 2. Or user profile document role == 'admin'
    // 3. Or bootstrap master admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin') ||
        request.auth.token.email == 'martsindia3@gmail.com' ||
        request.auth.token.email == 'sahanurmolla7076@gmail.com' ||
        request.auth.token.email == 'ventureforge.corp@gmail.com' ||
        request.auth.token.email == 'xsophiya99@gmail.com' ||
        request.auth.token.email == 'sahanurmolla190@gmail.com' ||
        request.auth.token.email == 'sahanurmolla3131@gmail.com' ||
        request.auth.token.email == 'sahanurmolla3545@gmail.com' ||
        request.auth.token.email == 'sahanurmolla2886@gmail.com' ||
        request.auth.token.email == 'iirdindia2025@gmail.com' ||
        request.auth.token.email == 'officialcloaktail@gmail.com' ||
        request.auth.token.email == 'prople.org@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidOrder() {
      return incoming().total is number && 
             incoming().total > 0 && 
             incoming().total <= 5000000 &&
             incoming().items is list && 
             incoming().items.size() > 0 && 
             incoming().items.size() <= 50;
    }

    // ==========================================
    // PRODUCTS COLLECTION (PUBLIC READ, ADMIN WRITE, RATING UPDATE)
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow update: if isValidId(productId) && (
        isAdmin() || 
        incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'reviewsCount', 'updatedAt'])
      );
      allow create, delete: if isAdmin() && isValidId(productId);
    }

    // ==========================================
    // REVIEWS COLLECTION (STOREFRONT & VERIFIED RATINGS)
    // ==========================================
    match /products/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isValidId(reviewId);
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isValidId(reviewId);
      allow delete: if isAdmin();
    }

    // ==========================================
    // SITE SETTINGS & HERO BANNERS (PUBLIC READ, ADMIN WRITE)
    // ==========================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(bannerId);
    }

    // ==========================================
    // USERS COLLECTION & SUBCOLLECTIONS (PII PROTECTED)
    // ==========================================
    match /users/{userId} {
      // Individual user profile and queries can be read by owner UID, owner by email, admin, or pre-auth lookup
      allow read: if isOwner(userId) || isEmailOwner() || isAdmin() || !isSignedIn();

      // User creation during signup
      allow create: if true;

      // User profile update (regular user cannot unblock themselves or escalate role)
      allow update: if isAdmin() || (isOwner(userId) && (!incoming().diff(existing()).affectedKeys().hasAny(['role', 'isBlocked', 'blocked', 'status', 'disabled']))) || (isEmailOwner() && (!incoming().diff(existing()).affectedKeys().hasAny(['role', 'isBlocked', 'blocked', 'status', 'disabled']))) || !isSignedIn();

      // Only admins can delete user records
      allow delete: if isAdmin();

      // --- Addresses Subcollection ---
      match /addresses/{addressId} {
        allow read, write: if true;
      }

      // --- Cart Subcollection ---
      match /cart/{cartItemId} {
        allow read, write: if true;
      }

      // --- Wishlist Subcollection ---
      match /wishlist/{wishlistId} {
        allow read, write: if true;
      }

      // --- User-Specific Orders Subcollection ---
      match /orders/{orderId} {
        allow read, write: if true;
      }

      // --- Notifications Subcollection ---
      match /notifications/{notifId} {
        allow read, write: if true;
      }
    }

    // ==========================================
    // GLOBAL ORDERS COLLECTION (CUSTOMER + ADMIN PIPELINE)
    // ==========================================
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder();
      allow update: if isValidId(orderId) && (isAdmin() || isValidOrder());
      allow delete: if isAdmin();
    }

    // ==========================================
    // PAYMENTS COLLECTION (SECURE AUDIT LOGS)
    // ==========================================
    match /payments/{paymentId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // ADMINS REGISTRY (ROLE GOVERNANCE)
    // ==========================================
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
