{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with personal details, default address, and contact info",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the user",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Primary phone number of the user",
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "description": "Full display name of the user",
          "maxLength": 100
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the user",
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "description": "Universal formatted primary delivery address",
          "maxLength": 500
        },
        "deliveryAddress": {
          "type": "object",
          "description": "Standard StoreDeliveryAddress object synchronized with Melody App"
        },
        "shippingAddress": {
          "type": "object",
          "description": "Standard StoreDeliveryAddress object for shipping"
        },
        "role": {
          "type": "string",
          "description": "Access role of the user (customer or admin)",
          "enum": ["customer", "admin"]
        },
        "orders": {
          "type": "array",
          "description": "Cached order summary list for the user"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of the last profile or address update"
        }
      },
      "required": ["name"]
    },
    "Address": {
      "title": "Address",
      "description": "Delivery address saved under user account",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the address"
        },
        "name": {
          "type": "string",
          "description": "Recipient full name",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Recipient contact phone number",
          "maxLength": 20
        },
        "pincode": {
          "type": "string",
          "description": "Postal pincode",
          "maxLength": 10
        },
        "houseNo": {
          "type": "string",
          "description": "House number, building name, flat details",
          "maxLength": 200
        },
        "area": {
          "type": "string",
          "description": "Street, colony, or locality details",
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "description": "City or district name",
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "description": "State or region name",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "description": "Address classification label",
          "enum": ["HOME", "WORK", "OTHER"]
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this address is the universal default"
        }
      },
      "required": ["name", "phone", "houseNo", "pincode", "city", "state"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog hardware product item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product SKU / ID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the product",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Hardware category"
        },
        "subCategory": {
          "type": "string",
          "description": "Hardware sub-category"
        },
        "price": {
          "type": "number",
          "description": "Current selling price in INR"
        },
        "oldPrice": {
          "type": "number",
          "description": "Original MRP before discount in INR"
        },
        "discount": {
          "type": "string",
          "description": "Discount badge text"
        },
        "rating": {
          "type": "number",
          "description": "Star rating out of 5"
        },
        "reviewsCount": {
          "type": "number",
          "description": "Total review count"
        },
        "image": {
          "type": "string",
          "description": "Primary product image URL stored in Firebase Storage or public CDN"
        },
        "images": {
          "type": "array",
          "description": "Gallery of product image URLs"
        },
        "description": {
          "type": "string",
          "description": "Product summary and sales pitch"
        },
        "brand": {
          "type": "string",
          "description": "Hardware manufacturer / brand name"
        },
        "highlights": {
          "type": "array",
          "description": "Key craftsmanship bullet points and product highlights"
        },
        "specGroups": {
          "type": "array",
          "description": "Grouped technical specifications (Dimensions, Materials, Weight, Care)"
        },
        "isAssured": {
          "type": "boolean",
          "description": "Guild authenticity seal and assurance badge"
        },
        "stock": {
          "type": "number",
          "description": "Available stock count"
        },
        "sellerName": {
          "type": "string",
          "description": "Artisan guild or seller trade name"
        },
        "sellerRating": {
          "type": "number",
          "description": "Artisan guild rating score"
        },
        "returnPolicy": {
          "type": "string",
          "description": "Return and replacement policy statement"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "name", "price", "image"]
    },
    "HeroBanner": {
      "title": "HeroBanner",
      "description": "Dynamic homepage hero banner configuration and image assets",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Hero banner ID"
        },
        "title": {
          "type": "string",
          "description": "Main banner headline",
          "maxLength": 300
        },
        "subtitle": {
          "type": "string",
          "description": "Supporting promotional body text",
          "maxLength": 600
        },
        "badgeText": {
          "type": "string",
          "description": "Top highlight badge text",
          "maxLength": 100
        },
        "ctaText": {
          "type": "string",
          "description": "Primary call-to-action button label",
          "maxLength": 60
        },
        "ctaLink": {
          "type": "string",
          "description": "Destination route or URL"
        },
        "imageUrl": {
          "type": "string",
          "description": "Hero showcase graphic URL stored in Firebase Storage"
        },
        "active": {
          "type": "boolean",
          "description": "Whether this hero configuration is live"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of banner update"
        }
      },
      "required": ["title", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with standardized pricing calculations and fulfillment milestone tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Order reference code"
        },
        "userId": {
          "type": "string",
          "description": "Purchaser UID"
        },
        "customerName": {
          "type": "string",
          "description": "Customer name"
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer contact number"
        },
        "customerEmail": {
          "type": "string",
          "description": "Customer contact email address"
        },
        "customerAddress": {
          "type": "string",
          "description": "Full shipping address text string"
        },
        "shippingAddress": {
          "type": "object",
          "description": "Standardized StoreDeliveryAddress object for shipment and courier routing"
        },
        "total": {
          "type": "number",
          "description": "Final payable order total in INR"
        },
        "mrp": {
          "type": "number",
          "description": "Original Maximum Retail Price sum of all line items"
        },
        "subtotal": {
          "type": "number",
          "description": "Base subtotal amount before customization and discounts"
        },
        "discount": {
          "type": "number",
          "description": "Discount applied on the order"
        },
        "savings": {
          "type": "number",
          "description": "Customer savings amount in INR"
        },
        "customizationFee": {
          "type": "number",
          "description": "Customization fee for bespoke engraving or personalization"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Delivery / shipping charge in INR"
        },
        "itemCount": {
          "type": "number",
          "description": "Total quantity of artisan goods in the order"
        },
        "pricing": {
          "type": "object",
          "description": "Complete standardized order pricing breakdown calculation object"
        },
        "status": {
          "type": "string",
          "description": "Current order lifecycle status",
          "enum": ["Processing", "Shipped", "Delivered", "Cancelled", "Failed"]
        },
        "paymentId": {
          "type": "string",
          "description": "Payment gateway transaction reference identifier"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment instrument used (Online Payment / Cash on Delivery)"
        },
        "paymentStatus": {
          "type": "string",
          "description": "Settlement state of payment (PAID / PENDING / REFUNDED / FAILED)"
        },
        "tracking": {
          "type": "object",
          "description": "Milestone-by-milestone fulfillment tracking steps with completion states and timestamps"
        },
        "statusHistory": {
          "type": "array",
          "description": "Audit history array documenting timestamped order state changes"
        },
        "items": {
          "type": "array",
          "description": "Line items in the order including quantities and customizations"
        },
        "date": {
          "type": "string",
          "description": "Formatted local order date string"
        },
        "createdAt": {
          "type": "number",
          "description": "Order placement timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last order status or details modification timestamp"
        }
      },
      "required": ["id", "userId", "total", "status"]
    },
    "CarouselBanner": {
      "title": "CarouselBanner",
      "description": "Storefront carousel slide banner with direct product link support",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Banner identifier"
        },
        "title": {
          "type": "string",
          "description": "Main banner headline text",
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "description": "Artisanal storytelling subtitle text",
          "maxLength": 400
        },
        "tag": {
          "type": "string",
          "description": "Category badge or craft collection pill label",
          "maxLength": 100
        },
        "image": {
          "type": "string",
          "description": "High resolution widescreen carousel image URL"
        },
        "fallbackImage": {
          "type": "string",
          "description": "Local media asset fallback URL"
        },
        "link": {
          "type": "string",
          "description": "Storefront navigation path (e.g. /product/1 or /products)"
        },
        "productId": {
          "type": "string",
          "description": "Target product ID for direct deep linking"
        },
        "ctaText": {
          "type": "string",
          "description": "Call to action button text",
          "maxLength": 60
        },
        "order": {
          "type": "number",
          "description": "Display order index in the carousel"
        },
        "active": {
          "type": "boolean",
          "description": "Whether this banner is visible on the live storefront"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "title", "image", "ctaText", "active"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with universal contact and address details"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": "Address",
      "description": "User saved shipping addresses"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Storefront equipment products managed via admin panel"
    },
    "/banners/{bannerId}": {
      "schema": "CarouselBanner",
      "description": "Storefront interactive carousel banner slides"
    },
    "/settings/{settingId}": {
      "schema": "HeroBanner",
      "description": "Site-wide configuration and hero banner settings"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Global order management registry"
    }
  }
}
